<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  PARALLEL: parallel="tests" — MỖI khối <test> LÀ MỘT DEVICE.
  thread-count = SỐ DEVICE ĐANG CHẠY THẬT (hiện 1 emulator → 1). Đây là chỗ DUY NHẤT đổi số luồng.
  Thêm device: copy 1 khối <test>, đổi deviceKey (khai trong capabilities/devices.json, systemPort riêng), tăng thread-count.
-->
<suite name="Book Anhtester — Android" parallel="tests" thread-count="1" verbose="1">
    <listeners>
        <listener class-name="com.anhtester.mobile.listeners.TestLogListener"/>
        <listener class-name="com.anhtester.mobile.listeners.ScreenshotListener"/>
    </listeners>

    <test name="Pixel_10_Pro_XL · emulator-5554">
        <parameter name="platform" value="android"/>
        <parameter name="deviceKey" value="android_pixel_10_pro_xl"/>
        <classes>
            <class name="com.anhtester.mobile.tests.SignInTest"/>
            <class name="com.anhtester.mobile.tests.SignInValidationTest"/>
        </classes>
    </test>

    <!-- Thiết bị thứ 2 — bỏ comment khi có emulator-5556 và tăng thread-count="2"
    <test name="Pixel_8 · emulator-5556">
        <parameter name="platform" value="android"/>
        <parameter name="deviceKey" value="android_pixel_8"/>
        <classes>
            <class name="com.anhtester.mobile.tests.SignInTest"/>
            <class name="com.anhtester.mobile.tests.SignInValidationTest"/>
        </classes>
    </test>
    -->
</suite>
