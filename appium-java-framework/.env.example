# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Appium server (cài cục bộ trong project: npm install && npm run appium)
APPIUM_SERVER=http://127.0.0.1:4723

# File capabilities — mặc định capabilities/devices.json. Muốn dùng file ở gốc repo: ../capabilities.json
CAPABILITIES_FILE=capabilities/devices.json

# Thời gian chờ thông minh (giây)
EXPLICIT_WAIT_SECONDS=20

# Tài khoản đã đăng ký trên app Book Anhtester (để chạy test đăng nhập thành công)
BOOK_USER_EMAIL=
BOOK_USER_PASSWORD=
