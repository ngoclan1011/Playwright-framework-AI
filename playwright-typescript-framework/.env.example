# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit .env

# Hệ thống cần test (web và API cùng host)
BASE_URL=https://book.anhtester.com

# Tài khoản demo — tự đăng ký ở https://book.anhtester.com/sign-up rồi điền vào đây.
# Chỉ các test gắn tag @auth mới cần 2 biến này; để trống vẫn chạy được `npm run test:public`.
TEST_EMAIL=
TEST_PASSWORD=

# Perfex CRM (test CRM_LOGIN_*) — chỉ test gắn @auth mới cần tài khoản
# ===== Perfex CRM (crm.anhtester.com) — module LOGIN =====
CRM_URL=https://crm.anhtester.com
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=
CRM_PM_EMAIL=projectmanager@example.com
CRM_PM_PASSWORD=
# Để trống thì test tương ứng tự skip (CRM_LOGIN_TC_019/020 cần Customer, CRM_LOGIN_TC_014 cần staff có mật khẩu chứa chữ cái)
CRM_CUSTOMER_EMAIL=
CRM_CUSTOMER_PASSWORD=
CRM_TC014_EMAIL=
CRM_TC014_PASSWORD=

# Số luồng chạy song song CHO MỖI TRÌNH DUYỆT — ĐỔI Ở ĐÂY, đúng 1 chỗ.
# Test giao diện chạy lần lượt Chrome → Edge → Firefox; mỗi trình duyệt chạy song song đúng số luồng này.
WORKERS=5

# false = mở trình duyệt thật (debug) · true = chạy ẩn (CI)
HEADLESS=true

# Thư mục chứa trình duyệt Playwright tải về (Firefox, ffmpeg) — mặc định .browsers trong project.
# Cài bằng: npm run browsers:install. Chrome và Edge dùng bản cài sẵn trên máy.
PLAYWRIGHT_BROWSERS_PATH=.browsers

# Timeout mỗi test (ms)
TIMEOUT=60000
